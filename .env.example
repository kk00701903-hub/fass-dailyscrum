# Grafana 대시보드 iframe — Share → Embed 에서 복사한 전체 URL

# VITE_GRAFANA_DASHBOARD_EMBED_URL=https://your-grafana/d/uid/slug?orgId=1&kiosk&theme=dark



# ─── JIRA Cloud (실제 값은 .env.local) ───────────────────────────────────────

# VITE_JIRA_BASE_URL=https://your-org.atlassian.net

# VITE_JIRA_EMAIL=you@company.com

# VITE_JIRA_API_TOKEN=your-atlassian-api-token

# VITE_JIRA_PROJECT_KEY=PROJ

# 스프린트 동기화: 스크럼 보드 ID (칸반-only 보드는 스프린트 API 미지원)
# VITE_JIRA_BOARD_ID=1

# VITE_JIRA_STORY_POINTS_FIELD=customfield_10016



# ─── 사내 SSL 검사 / 프록시 (개발·CLI 전용, 프로덕션 배포 금지) ─────────────

# Vite dev 서버가 JIRA 로 프록시할 때 TLS 인증서 검증 생략 (rejectUnauthorized: false)

# JIRA_PROXY_TLS_INSECURE=1

#

# npm run test:jira CLI — 위와 동일하게 1 이면 Vite 프록시도 TLS 생략

# JIRA_TEST_TLS_INSECURE=1



# CLI 요청·응답 디버그

# JIRA_TEST_DEBUG=1



# ─── Supabase (JIRA → Edge Function → DB → 앱) ───────────────────────────────
# Dashboard → Project Settings → API
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Edge Function 시크릿 (Supabase Dashboard → Edge Functions → Secrets)
# JIRA_BASE_URL, JIRA_EMAIL, JIRA_API_TOKEN, JIRA_BOARD_ID=1, JIRA_PROJECT_KEY

# 마이그레이션: supabase/migrations/20260518120000_jira_scrum.sql

