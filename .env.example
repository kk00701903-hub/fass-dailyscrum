# Grafana 대시보드 iframe — Share → Embed 에서 복사한 전체 URL

# VITE_GRAFANA_DASHBOARD_EMBED_URL=https://your-grafana/d/uid/slug?orgId=1&kiosk&theme=dark



# ─── JIRA Cloud (실제 값은 .env.local) ───────────────────────────────────────
# 인증 정책: docs/JIRA_AUTH.md — 팀 서비스 계정 토큰은 Supabase Edge Secrets 에만 둡니다.

# VITE_JIRA_BASE_URL=https://your-org.atlassian.net
# (선택, 로컬 Vite 프록시 디버그용) VITE_JIRA_EMAIL=scrum-sync@company.com
# (선택, 로컬 Vite 프록시 디버그용) VITE_JIRA_API_TOKEN=your-atlassian-api-token
# 브라우저·npm run dev: Supabase jira-proxy 우선. VITE_JIRA_* 토큰 없이도 동기화 가능.
# Node CLI·Edge: JIRA_API_TOKEN (접두사 없음) — Supabase Dashboard → Edge Functions → Secrets

# VITE_JIRA_PROJECT_KEY=PROJ

# 스프린트 동기화: 스크럼 보드 ID (칸반-only 보드는 스프린트 API 미지원)
# VITE_JIRA_BOARD_ID=1

# VITE_JIRA_STORY_POINTS_FIELD=customfield_10016
# VITE_JIRA_START_DATE_FIELD=customfield_10015



# ─── 사내 SSL 검사 / 프록시 (개발·CLI 전용, 프로덕션 배포 금지) ─────────────

# Vite dev 서버가 JIRA 로 프록시할 때 TLS 인증서 검증 생략 (rejectUnauthorized: false)

# JIRA_PROXY_TLS_INSECURE=1

#

# npm run test:jira CLI — 위와 동일하게 1 이면 Vite 프록시도 TLS 생략

# JIRA_TEST_TLS_INSECURE=1



# CLI 요청·응답 디버그

# JIRA_TEST_DEBUG=1



# ─── Supabase (JIRA → Edge Function → DB → 앱) ───────────────────────────────
# Dashboard → Project Settings → API
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Edge Function 시크릿 (Supabase Dashboard → Edge Functions → Secrets) — 연 1회 갱신
# JIRA_BASE_URL, JIRA_EMAIL, JIRA_API_TOKEN, JIRA_BOARD_ID=1, JIRA_PROJECT_KEY
# JIRA_STORY_POINTS_FIELD, JIRA_START_DATE_FIELD (선택)

# 마이그레이션: supabase/migrations/20260518120000_jira_scrum.sql

# ─── 웹 푸시 (스크럼 미입력 알림) ─────────────────────────────────────────────
# 문서: docs/WEB_PUSH.md
# Vite 빌드(프론트) — 공개키만
# VITE_WEB_PUSH_PUBLIC_KEY=BKx...
#
# Edge Functions Secrets (Dashboard)
# VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT=mailto:you@domain
# CRON_SECRET=랜덤_긴_문자열
# PUBLIC_APP_URL=https://계정.github.io/저장소명   (알림 클릭 시 열 주소, 선택)
